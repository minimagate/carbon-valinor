---
import Base from "../layouts/Base.astro";
import Chart from "../components/Chart.astro";
import { asset } from "../lib/paths";
import { monitored, verified, manualCost, ourCost } from "../data/series";
---

<Base>
    <main>
        <section class="hero" id="platform">
            <div class="col">
                <span
                    class="logo"
                    role="img"
                    aria-label="Carbon Valinor"
                    style={`--logo: url(${asset("logo.svg")})`}
                ></span>
                <p data-words>
                    <span class="lead" role="heading" aria-level="1">
                        Carbon Valinor builds intelligence for carbon removal.
                    </span>{" "}
                    We develop software that uses machine-learning models to
                    capture, move and store carbon dioxide more efficiently, and
                    to prove with measurable certainty that it stays out of the
                    atmosphere for good.
                </p>
                <p data-words>
                    Removing carbon at the scale the climate demands is a
                    problem of physics, engineering and trust. We treat it as a
                    problem of information.
                </p>
            </div>
        </section>

        <section class="col" id="monitoring">
            <p data-words>
                <span class="lead">Models that see underground.</span> Our
                models learn from every signal a storage site produces:
                pressure, temperature, seismic, fibre-optic and satellite data.
                They pair physical simulation with machine learning to forecast
                how carbon moves through rock, so operators know where it is,
                where it is going, and the moment anything departs from
                expectation. Across the sites we model,{" "}
                <span class="counter" data-keep>
                    1,243,118
                </span>{" "}
                tonnes are under continuous watch.
            </p>
            <Chart
                id="stored"
                series={[
                    {
                        label: "CO₂ monitored",
                        value: "1.24 Mt",
                        data: monitored,
                    },
                    { label: "Verified", value: "1.17 Mt", data: verified },
                ]}
            />
        </section>

        <section class="col" id="cost">
            <p data-words>
                <span class="lead">Compunded efficiency.</span> Every stage of
                the carbon chain, from capture to compression, transport and
                injection, loses energy to conditions no one optimises in real
                time. Our software tunes each stage against the whole and
                automates the measurement and verification still done by hand.
                The cost of a permanently stored tonne falls; the standard of
                proof rises.
            </p>
            <Chart
                id="cost"
                series={[
                    {
                        label: "Manual, per tonne",
                        value: "$18.40",
                        data: manualCost,
                    },
                    {
                        label: "With Carbon Valinor",
                        value: "$4.20",
                        data: ourCost,
                    },
                ]}
            />
        </section>

        <section class="col" id="contact">
            <p data-words>
                <span class="lead">Work with us.</span> We partner with the
                companies that capture, transport and store carbon, and with
                those who must account for it. If that is you, write to us.
            </p>
            <p class="closing" data-words>
                <a class="mail" href="mailto:info@carbonvalinor.com">
                    info@carbonvalinor.com
                </a>
            </p>
            <footer>
                <span data-words>© 2026 Carbon Valinor</span>
            </footer>
        </section>
    </main>
</Base>
