---
// Minimal two-series line chart, rendered to static SVG at build time.
// The first series is drawn solid, the second dashed; the space between them is hatched.
interface Series {
  label: string;
  value: string;
  data: number[];
}
interface Props {
  id: string;
  series: [Series, Series];
}

const { id, series } = Astro.props;

const W = 680;
const H = 280;
const pad = { t: 10, r: 6, b: 2, l: 2 };
const all = series.flatMap((s) => s.data);
const max = Math.max(...all) * 1.08;
const min = 0;
const n = series[0].data.length;

const x = (i: number) => pad.l + (i / (n - 1)) * (W - pad.l - pad.r);
const y = (v: number) => pad.t + (1 - (v - min) / (max - min)) * (H - pad.t - pad.b);
const pts = (d: number[]) => d.map((v, i) => [x(i), y(v)] as const);
const path = (d: number[]) =>
  pts(d).map(([px, py], i) => `${i ? 'L' : 'M'}${px.toFixed(1)},${py.toFixed(1)}`).join('');

const [a, b] = series;
const band =
  path(a.data) +
  pts(b.data)
    .reverse()
    .map(([px, py]) => `L${px.toFixed(1)},${py.toFixed(1)}`)
    .join('') +
  'Z';

const grid = [0.25, 0.5, 0.75].map((f) => pad.t + f * (H - pad.t - pad.b));
const base = H - pad.b;
const endA = pts(a.data)[n - 1];
const endB = pts(b.data)[n - 1];
---

<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${a.label} ${a.value}, ${b.label} ${b.value}`}>
    <defs>
      <pattern id={`hatch-${id}`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="rgba(0,0,0,0.09)" stroke-width="1" />
      </pattern>
    </defs>

    {grid.map((gy) => (
      <line x1={pad.l} x2={W - pad.r} y1={gy} y2={gy} class="grid" />
    ))}
    <line x1={pad.l} x2={W - pad.r} y1={base} y2={base} class="base" />

    <g class="plot">
      <path d={band} fill={`url(#hatch-${id})`} />
      <path d={path(b.data)} class="line-b" />
      <path d={path(a.data)} class="line-a" />
    </g>
    <circle cx={endB[0]} cy={endB[1]} r="4" class="dot dot-b" />
    <circle cx={endA[0]} cy={endA[1]} r="5" class="dot dot-a" />
  </svg>

  <figcaption class="chart-foot">
    <ul class="legend">
      <li><i class="key key-a"></i>{a.label} <b>{a.value}</b></li>
      <li><i class="key key-b"></i>{b.label} <b>{b.value}</b></li>
    </ul>
  </figcaption>
</figure>

<style>
  .chart { margin: 3.25rem 0 3rem; color: #8f8f8f; font-size: 0.8125rem; letter-spacing: -0.002em; }
  svg { display: block; width: 100%; height: auto; overflow: visible; }

  .grid { stroke: #e4e4e4; stroke-width: 1; stroke-dasharray: 2 4; }
  .base { stroke: #dcdcdc; stroke-width: 1; }
  .line-a { fill: none; stroke: #3a3a3a; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .line-b { fill: none; stroke: #a6a6a6; stroke-width: 1.75; stroke-dasharray: 4 4; stroke-linejoin: round; }
  .dot-a { fill: #3a3a3a; }
  .dot-b { fill: #a6a6a6; }

  .chart-foot { margin-top: 1rem; }
  .legend { display: flex; flex-wrap: wrap; gap: 0.4rem 1.5rem; list-style: none; }
  .legend li { display: flex; align-items: center; gap: 0.55rem; }
  .legend b { color: #3a3a3a; font-weight: 600; }
  .key { display: inline-block; width: 14px; }
  .key-a { height: 2px; background: #3a3a3a; border-radius: 1px; }
  .key-b { height: 0; border-top: 2px dashed #a6a6a6; }

  /* Same motion as the text: comes into focus, then the lines draw in. Plays when the chart itself scrolls into view */
  :global(.anim) .chart { opacity: 0; filter: blur(8px); }
  :global(.anim) .plot { clip-path: inset(0 100% 0 0); }
  :global(.anim) .dot { opacity: 0; }
  :global(.anim) .chart:global(.seen) { animation: wordIn 1.2s cubic-bezier(0.33, 0, 0.2, 1) both; }
  :global(.anim) .chart:global(.seen) .plot { clip-path: inset(0 0 0 0); transition: clip-path 2.8s cubic-bezier(0.45, 0, 0.2, 1) 0.4s; }
  :global(.anim) .chart:global(.seen) .dot { opacity: 1; transition: opacity 1s ease 2.7s; }

  @media (prefers-reduced-motion: reduce) {
    :global(.anim) .chart, :global(.anim .in) .chart { opacity: 1; filter: none; animation: none; }
    :global(.anim) .plot, :global(.anim .in) .plot { clip-path: none; transition: none; }
    :global(.anim) .dot, :global(.anim .in) .dot { opacity: 1; transition: none; }
  }
</style>
